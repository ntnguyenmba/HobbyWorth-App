{
  "expo": {
    "name": "HobbyWorth",
    "slug": "hobbyworth",
    "scheme": "hobbyworth",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./play_store_512.png",
    "splash": {
      "image": "./play_store_512.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF7"
    },
    "locales": {
      "en": "./native-locales/en.json",
      "es": "./native-locales/es.json",
      "vi": "./native-locales/vi.json",
      "fr": "./native-locales/fr.json",
      "de": "./native-locales/de.json",
      "zh-Hans": "./native-locales/zh-Hans.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.everittventures.hobbyworth",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "HobbyWorth uses photos you choose for your project record.",
        "CFBundleAllowMixedLocalizations": true,
        "UISupportsDocumentBrowser": false,
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.everittventures.hobbyworth",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./play_store_512.png",
        "backgroundColor": "#FFFDF7"
      }
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "vi",
              "fr",
              "de",
              "zh-Hans"
            ],
            "android": [
              "en",
              "es",
              "vi",
              "fr",
              "de",
              "zh-Hans"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HobbyWorth uses photos you choose for your project record."
        }
      ],
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8647405301136182~1647088699",
          "iosAppId": "ca-app-pub-8647405301136182~4273252030"
        }
      ]
    ],
    "extra": {
      "iosIapProductId": "com.everittventures.hobbyworth.lifetime",
      "androidIapProductId": "com.everittventures.hobbyworth.lifetime",
      "androidAdMobBannerUnitId": "ca-app-pub-8647405301136182/4451189318",
      "iosAdMobBannerUnitId": "ca-app-pub-8647405301136182/2656918030",
      "purchaseVerifyUrl": "https://app.everittventures.com/api/mobile/google/verify"
    }
  }
}
