{
  "name": "hobbyworth-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npm run sync:artwork && expo start --dev-client",
    "ios": "npm run sync:artwork && expo run:ios",
    "android": "npm run sync:artwork && expo run:android",
    "prebuild": "npm run sync:artwork && expo prebuild",
    "prebuild:clean": "npm run sync:artwork && expo prebuild --clean",
    "android:codegen": "cd android && ./gradlew generateCodegenArtifactsFromSchema",
    "android:signing": "node scripts/configure-android-signing.mjs",
    "build:android:local": "npm run sync:artwork && expo prebuild --clean --platform android && npm run android:signing && npm run android:codegen && cd android && ./gradlew bundleRelease",
    "prepare:ios:local": "npm run sync:artwork && expo prebuild --clean --platform ios",
    "open:ios": "open ios/HobbyWorth.xcworkspace",
    "typecheck": "node scripts/check-locales.mjs && node scripts/check-config.mjs && npm test && tsc --noEmit",
    "test": "node scripts/check-ad-consent.mjs && node scripts/check-purchase-restore.mjs && node --import tsx --test src/math.test.ts src/quiz.test.ts",
    "sync:artwork": "node scripts/sync-hobby-art.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.7",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-iap": "^3.3.0",
    "expo-image-picker": "~55.0.12",
    "expo-localization": "~55.0.9",
    "expo-print": "~55.0.8",
    "expo-sharing": "~55.0.10",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-google-mobile-ads": "16.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "expo-build-properties": "~55.0.18",
    "expo-tracking-transparency": "~55.0.18",
    "@expo/vector-icons": "^15.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~55.0.0",
    "typescript": "~5.9.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0"
  }
}

