{
  "name":"hobbyworth-app",
  "version":"1.0.0",
  "private":true,
  "main":"index.js",
  "scripts":{
    "postinstall":"node scripts/prepare-assets.mjs",
    "prepare-assets":"node scripts/prepare-assets.mjs",
    "start":"npm run prepare-assets && expo start --dev-client",
    "ios":"npm run prepare-assets && expo run:ios",
    "android":"npm run prepare-assets && expo run:android",
    "prebuild":"npm run prepare-assets && expo prebuild",
    "prebuild:clean":"npm run prepare-assets && expo prebuild --clean",
    "build:android:local":"npm run prepare-assets && expo prebuild --clean --platform android && cd android && ./gradlew clean bundleRelease",
    "prepare:ios:local":"npm run prepare-assets && expo prebuild --clean --platform ios",
    "open:ios":"open ios/HobbyWorth.xcworkspace",
    "typecheck":"node scripts/check-locales.mjs && tsc --noEmit"
  },
  "dependencies":{"@expo-google-fonts/nunito":"^0.4.2","@react-native-async-storage/async-storage":"^2.2.0","expo":"~55.0.0","expo-constants":"~55.0.7","expo-file-system":"~55.0.26","expo-font":"~55.0.8","expo-iap":"^3.3.0","expo-image-picker":"~55.0.12","expo-localization":"~55.0.9","expo-print":"~55.0.8","expo-sharing":"~55.0.10","expo-status-bar":"~55.0.6","react":"19.2.0","react-native":"0.83.2","react-native-google-mobile-ads":"16.3.4","react-native-safe-area-context":"~5.6.0"},
  "devDependencies":{"@types/react":"~19.1.10","typescript":"~5.9.2"}
}
